#: dialog.c:2064
#, c-format
msgid "Expected no more than %d tokens for %.*s, have %d"
msgstr "მოველოდი არაუმეტეს %d ტოკენს %.*s-ისთვის. მივიღე %d"

#: dialog.c:2128
#, c-format
msgid "Expected --and-widget, not %.*s"
msgstr "მოველოდი პარამეტრს --and-widget და არა %.*s"

